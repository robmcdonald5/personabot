# Production environment template — COMMITTED, no real values here.
# Real values live in .env.prod on the deployment host (gitignored).
#
# This file is the source of truth for which variables the prod stack
# needs. When deploying for the first time:
#   1. scp this file to the VM as .env.prod
#   2. fill in the <placeholder> values
#   3. chmod 600 .env.prod
#   4. docker compose -f docker-compose.prod.yml up -d
#
# docker-compose.prod.yml reads .env.prod via its `env_file:` directive,
# so these variables become the bot container's environment. The
# structural validator in src/personabot/config.py rejects
# ENVIRONMENT=production + DATABASE_URL pointing at localhost, so the
# hostname below must be the Compose bridge-network service name
# ("postgres"), not "localhost".

ENVIRONMENT=production

# Database — bot container reaches Postgres via the Compose bridge network,
# NOT via loopback. The service name "postgres" is what docker-compose.prod.yml
# calls the container.
POSTGRES_USER=personabot
POSTGRES_PASSWORD=<strong random password — generate with `openssl rand -base64 32`>
POSTGRES_DB=personabot
DATABASE_URL=postgresql://personabot:${POSTGRES_PASSWORD}@postgres:5432/personabot

# Discord — production bot token (DIFFERENT from dev token — register a
# second Discord application at https://discord.com/developers/applications)
DISCORD_TOKEN=<production bot token>

# Leave empty in production. The bot global-syncs commands on startup if
# AUTO_SYNC_COMMANDS=true and DEV_GUILD_ID is unset; global syncs are
# rate-limited, so flip AUTO_SYNC_COMMANDS=false and trigger a manual sync
# only when command definitions change.
DEV_GUILD_ID=
AUTO_SYNC_COMMANDS=false

# Dead-man-switch — the bot pings this URL at the end of every successful
# retention_cleanup tick. Register a check at https://healthchecks.io and
# paste the ping URL here. Missed pings alert via email / Slack / PagerDuty.
HEALTHCHECK_URL=https://hc-ping.com/<your-retention-cleanup-check-uuid>

# Scraping defaults (tune per deployment)
DEFAULT_LIMIT=10000

# Pipeline / Export
TOKEN_BUDGET=100000
TOP_N_MESSAGES=1000
WINDOW_GAP_HOURS=4
MEDIA_REACTION_THRESHOLD=2

# Retention — hours before scraped data is auto-deleted
RETENTION_HOURS=24
