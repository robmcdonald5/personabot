# Discord
DISCORD_TOKEN=
# Optional: set for instant command sync during development
# DEV_GUILD_ID=
# Auto-sync the command tree on startup. Guild sync (dev mode) is always
# on; global sync (production) is rate-limited and discouraged for every
# restart. Set to false in production and trigger a manual sync when
# command definitions change.
# AUTO_SYNC_COMMANDS=true

# Storage — base directory for DB, media, and exports
# DATA_DIR=data

# Scraping
DEFAULT_LIMIT=10000

# Pipeline / Export
TOKEN_BUDGET=100000
TOP_N_MESSAGES=1000
WINDOW_GAP_HOURS=4
MEDIA_REACTION_THRESHOLD=2

# Retention — hours before scraped data is auto-deleted
RETENTION_HOURS=24
