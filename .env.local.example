# Local development template — COMMITTED, no real values here.
# Real values live in .env.local (gitignored) — copy this file and fill in.
#
#   cp .env.local.example .env.local
#   # edit .env.local and fill in DISCORD_TOKEN and DEV_GUILD_ID from
#   # https://discord.com/developers/applications
#
# Load before running the bot:
#   bash/zsh (WSL2):  set -a; source .env.local; set +a
#   PowerShell:       Get-Content .env.local | Where-Object {$_ -notmatch '^\s*(#|$)'} | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#
# pydantic-settings does NOT auto-load .env files (removed in the
# Postgres migration to prevent cross-environment mixups). You must
# export these variables into the process environment yourself.

# Required
ENVIRONMENT=development
DATABASE_URL=postgresql://personabot:dev@localhost:5433/personabot

# Discord — fill in both from the Developer Portal. DEV_GUILD_ID enables
# instant guild-scoped command sync during development; without it the
# bot global-syncs on startup which is rate-limited.
DISCORD_TOKEN=
DEV_GUILD_ID=
AUTO_SYNC_COMMANDS=true

# Scraping defaults (tune as needed)
DEFAULT_LIMIT=10000

# Pipeline / Export
TOKEN_BUDGET=100000
TOP_N_MESSAGES=1000
WINDOW_GAP_HOURS=4
MEDIA_REACTION_THRESHOLD=2

# Retention — hours before scraped data is auto-deleted
RETENTION_HOURS=24

# Optional: dead-man-switch URL for retention loop (leave empty in dev)
HEALTHCHECK_URL=
